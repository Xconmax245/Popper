# Popper Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it is already in .gitignore

# ============================================================
# OPENROUTER — Primary LLM Provider
# Get your key at https://openrouter.ai/
# Preset: "Project Free AI" (max_price: 0, allow_fallbacks: true)
# ============================================================
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# Optional: override the model slug used by each agent without a code change.
# Handy if a free-tier slug is renamed/retired. Defaults are shown below.
# MODEL_EXTRACTOR=openai/gpt-oss-20b:free
# MODEL_VERIFIER=openai/gpt-oss-20b:free
# MODEL_SYNTHESIS=nvidia/nemotron-3-ultra:free
# MODEL_AUDIT=openai/gpt-oss-20b:free
# MODEL_FALLBACK=poolside/laguna-xs-2.1:free


# ============================================================
# SUPABASE — Database, Realtime, and Auth
# Get from: Project Settings > API in your Supabase dashboard
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyYOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyYOUR_SERVICE_ROLE_KEY

# ============================================================
# SEMANTIC SCHOLAR — Optional API key
# Free without a key (100 req/5min). With a key: 1 req/sec, no daily cap.
# Get from: https://www.semanticscholar.org/product/api
# ============================================================
SEMANTIC_SCHOLAR_API_KEY=

# ============================================================
# CROSSREF — No key needed. This is your contact email for the
# "polite pool" which gets faster response times.
# ============================================================
CROSSREF_MAILTO=your@email.com
